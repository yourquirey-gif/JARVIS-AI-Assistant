{
  "name": "ultron-ai-assistant",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "android:sync": "cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {},
  "devDependencies": {
    "@capacitor-community/speech-recognition": "7.0.1",
    "@capacitor/android": "7.4.3",
    "@capacitor/cli": "7.4.3",
    "@capacitor/core": "7.4.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "22.3.27",
    "electron-builder": "24.13.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.171.0",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "com.dsacademy.ultron",
    "productName": "ULTRON",
    "electronVersion": "22.3.27",
    "directories": {
      "output": "desktop-release"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/ULTRON-PC-Service.exe",
        "to": "ULTRON-PC-Service.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ULTRON-Windows-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ]
  }
}
